<Window x:Class="ScreenCaptureApp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipArc settings" Width="640" Height="770" MinWidth="580" MinHeight="670"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20" />

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="Capture folder" VerticalAlignment="Center" />
      <TextBox x:Name="FolderBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Capture folder" />
      <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…" Click="Browse_Click" AutomationProperties.Name="Browse for capture folder" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="Quick-save format" VerticalAlignment="Center" />
      <ComboBox x:Name="FormatBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center" AutomationProperties.Name="Quick-save image format">
        <ComboBoxItem Content="PNG" Tag="Png" /><ComboBoxItem Content="JPEG" Tag="Jpeg" /><ComboBoxItem Content="BMP" Tag="Bmp" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
      <TextBlock Text="JPEG quality" VerticalAlignment="Center" />
      <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="50" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
              ValueChanged="QualitySlider_ValueChanged" AutomationProperties.Name="JPEG quality" />
      <TextBlock x:Name="QualityLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="Capture shortcut" VerticalAlignment="Center" />
      <ComboBox x:Name="HotkeyBox" Grid.Column="1" Width="190" HorizontalAlignment="Left" MinHeight="32" VerticalContentAlignment="Center"
                AutomationProperties.Name="Global capture shortcut">
        <ComboBoxItem Content="Print Screen" Tag="PrintScreen" />
        <ComboBoxItem Content="Ctrl + Shift + 4" Tag="CtrlShift4" />
        <ComboBoxItem Content="Ctrl + Shift + S" Tag="CtrlShiftS" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="5" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Translation endpoint" VerticalAlignment="Center" />
      <TextBox x:Name="TranslationEndpointBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center"
               AutomationProperties.Name="LibreTranslate endpoint"
               AutomationProperties.HelpText="A LibreTranslate-compatible URL ending in /translate. Must be HTTPS unless it runs on this computer."
               ToolTip="LibreTranslate-compatible API URL, for example https://translate.example.com/translate" />
      <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Foreground="#686870" TextWrapping="Wrap" FontSize="11"
                 Text="Leave blank to turn translation off. The URL must end in /translate and use HTTPS, unless the service runs on this computer (http://127.0.0.1)." />

      <TextBlock Grid.Row="2" Text="Translation API key" VerticalAlignment="Center" Margin="0,12,0,0" />
      <PasswordBox x:Name="TranslationApiKeyBox" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,12,0,0"
                   VerticalContentAlignment="Center"
                   AutomationProperties.Name="Translation API key"
                   AutomationProperties.HelpText="Required by hosted LibreTranslate services. Leave blank for a self-hosted instance that does not ask for one." />
      <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Foreground="#686870" TextWrapping="Wrap" FontSize="11"
                 Text="The hosted libretranslate.com service is paid and needs a key. Running your own LibreTranslate server is free and usually needs none. The key is stored in this computer's SnipArc settings file." />
    </Grid>

    <Grid Grid.Row="6" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="Translate to" VerticalAlignment="Center" />
      <ComboBox x:Name="TranslationLanguageBox" Grid.Column="1" MinHeight="32" VerticalContentAlignment="Center"
                AutomationProperties.Name="Translation target language">
        <ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Spanish" Tag="es" />
        <ComboBoxItem Content="French" Tag="fr" /><ComboBoxItem Content="German" Tag="de" />
        <ComboBoxItem Content="Portuguese" Tag="pt" /><ComboBoxItem Content="Chinese" Tag="zh" />
        <ComboBoxItem Content="Japanese" Tag="ja" /><ComboBoxItem Content="Korean" Tag="ko" />
      </ComboBox>
    </Grid>

    <StackPanel Grid.Row="7">
      <CheckBox x:Name="StartupBox" Content="Start SnipArc when I sign in" Margin="0,5" />
      <CheckBox x:Name="CursorBox" Content="Include the mouse pointer in captures" Margin="0,5" />
      <CheckBox x:Name="NotificationsBox" Content="Show save and copy notifications" Margin="0,5" />
      <CheckBox x:Name="OverrideSnippingBox" Content="Use Windows + Shift + S for this app instead of Snipping Tool" Margin="0,5"
                AutomationProperties.Name="Override the Windows Snipping Tool shortcut"
                AutomationProperties.HelpText="While SnipArc is running, Windows plus Shift plus S opens SnipArc instead of Snipping Tool." />
      <TextBlock Margin="0,18,0,0" Foreground="#686870" TextWrapping="Wrap"
                 Text="Screenshots and local recognition stay on this computer. Translation sends only extracted text to the endpoint you configure; SnipArc has no telemetry." />
    </StackPanel>

    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True" />
      <Button Content="Save settings" IsDefault="True" Click="Save_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
